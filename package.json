{
  "name": "revenge-ai-plugin",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "rollup -c && node -e 'const fs=require(\"fs\"),c=require(\"crypto\");const h=c.createHash(\"sha256\").update(fs.readFileSync(\"dist/index.js\")).digest(\"hex\");const m=JSON.parse(fs.readFileSync(\"manifest.json\"));m.hash=h;fs.writeFileSync(\"manifest.json\",JSON.stringify(m,null,2));console.log(\"Hashed:\",h);'"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "rollup": "^3.29.0"
  }
}
